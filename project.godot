config_version=5

[application]

config/name="Overjacked 3 dollar"
run/main_scene="uid://doetk8gtoypxk"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="uid://bwlm2jcoofdrp"
config/icon="res://icon.svg"

[autoload]

Global="*uid://b1llkru46bccp"
DialogueManager="*uid://c3rodes2l3gxb"
Phone="*uid://bv6hd4ceokjm2"

[dialogue_manager]

runtime/balloon_path="res:///balloon.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

